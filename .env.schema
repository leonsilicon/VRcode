# VRcode build and release environment (https://varlock.dev/env-spec).
#
# The values live in GitHub repository secrets and reach the release workflow as environment
# variables (.github/workflows/mac-app-release.yml runs the build through `varlock run`, which
# validates them and redacts the sensitive ones). Local builds need none of them: they sign with
# the best Developer ID identity in the login Keychain. See docs/mac-app.md, "Releases".
#
# @defaultRequired=false @defaultSensitive=false
# ---

# Developer ID Application certificate with its private key, as base64 of a .p12. Tauri imports
# it into a temporary keychain and signs the app and its helpers with it.
# @sensitive
APPLE_CERTIFICATE=

# The .p12 export password.
# @sensitive
APPLE_CERTIFICATE_PASSWORD=

# Pins the signing identity, e.g. "Developer ID Application: Leon Si (M76P5G9HXK)". Without it,
# CI uses the certificate's own identity and local builds the best Keychain identity.
APPLE_SIGNING_IDENTITY=

# Notarization with an Apple ID: the account, an app-specific password, and the team.
# @sensitive
APPLE_ID=
# @sensitive
APPLE_PASSWORD=
APPLE_TEAM_ID=

# Or notarization with an App Store Connect API key: key ID, issuer ID and the AuthKey_<id>.p8
# path (the workflow writes the APPLE_API_PRIVATE_KEY secret to that file).
APPLE_API_KEY=
APPLE_API_ISSUER=
APPLE_API_KEY_PATH=

# The xmux checkout bundled as xmux-bridge (default ~/Developer/github/leonsilicon/xmux).
XMUX_DIR=
